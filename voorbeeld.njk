<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Voorbeeld — Chiro Spirit Heverlee</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.1/dist/css/bootstrap.min.css">

<style>
:root {
  --paars: #12294A; --teal: #C0272D; --grijs: #666666; --creme: #FAF5EC; --wit: #FFFFFF;
}
* { box-sizing: border-box; }
body {
  margin: 5px 0 0 0;
  font-family: "Barlow", "Lucida Sans Unicode", "Lucida Grande", Verdana, sans-serif;
  font-size: 1rem; line-height: 1.65rem; color: #222;
  min-height: 100vh; background-color: var(--paars);
}
h1, h2, h3 { color: var(--paars); font-weight: 500; margin-top: 24px; }
h1 { font-size: 2.8rem; margin: 0; }
h2 { font-size: 1.4rem; margin: 0 0 16px 0; padding-bottom: 6px; border-bottom: 1px dotted var(--paars); text-transform: uppercase; letter-spacing: .5px; }
h3 { font-size: 1.2rem; margin: 26px 0 8px 0; }
p { margin: 0 0 16px 0; }
a, a:hover { color: var(--teal); text-decoration: underline; }

.wrapper {
  width: 100%; max-width: 1050px; margin: 1.5rem auto; position: relative;
  border: 1px dotted var(--paars); border-radius: 3px; background: var(--wit);
  box-shadow: 0 14px 34px rgba(0,0,0,.35);
}
header.banner {
  text-align: center; padding: 22px 0 14px 0; background: var(--creme);
  border-bottom: 1px dotted var(--paars); border-radius: 3px 3px 0 0;
}
header.banner .sitenaam { color: var(--paars); font-weight: 700; cursor: pointer; }
header.banner small {
  display: block; font-size: 11px; font-weight: 400; color: var(--grijs);
  letter-spacing: 2px; text-transform: uppercase; margin-top: 4px;
}

nav.navbar { padding-top: 0; border-top: var(--paars) solid 8px; }
nav.navbar .navbar-collapse { justify-content: center; }
nav.navbar .navbar-nav { display: flex; }
nav.navbar .nav-link { color: var(--grijs); font-size: 1.2rem; padding: .35rem 1.2rem !important; cursor: pointer; }
nav.navbar .nav-link.active, nav.navbar .nav-link:hover { color: var(--wit) !important; background-color: var(--paars); }

.inhoud { padding: 0.5rem 2rem; }
@media only screen and (max-width: 600px) { .inhoud { padding: 0.5rem 0.75rem; } }

.pagina { display: none; padding: 20px 0 30px 0; }
.pagina.actief { display: block; }

.vak {
  background: var(--creme); border: 1px dotted var(--paars); border-radius: 3px;
  padding: 16px 18px; margin-bottom: 18px;
}
.vak-titel { margin: 0 0 6px 0; }
.vak .leeftijd { font-size: 0.9rem; margin-bottom: 10px; }
.vak p:last-child { margin-bottom: 0; }

ul.lijst { list-style: none; padding: 0; margin: 0; }
ul.lijst li { padding: 7px 2px; border-bottom: 1px dotted #ddd; }
ul.lijst li:before { content: "\25BA  "; color: var(--paars); }
ul.lijst-bollen li { border-bottom: none; padding: 1px 2px; }
ul.lijst-bollen li:before { content: "\2022  "; }
.lijst-info { display: block; color: var(--grijs); font-size: 0.9em; margin: 4px 0 2px 18px; }

.datum { font-weight: 600; color: var(--paars); }
.leeftijd { color: var(--teal); font-weight: 600; font-size: 12px; }
.leiding-groep { color: var(--grijs); margin-top: 4px; }
.leiding-groep strong { color: var(--paars); }

.foto {
  display: block; width: 60%; max-width: 420px; height: auto; margin-top: 8px;
  border: 1px dotted var(--paars); border-radius: 3px; box-shadow: 0 6px 16px rgba(0,0,0,.2);
}
.foto-midden { margin: 24px auto; }
.foto-galerij { display: flex; flex-wrap: wrap; gap: 12px; margin: 8px 0 16px 0; }
.foto-galerij .foto { width: calc(33.333% - 8px); max-width: none; margin-top: 0; }
@media only screen and (max-width: 600px) { .foto-galerij .foto { width: 100%; } }
</style>
</head>

<body>
<main class="container wrapper">

  <header class="banner">
    <h1 class="sitenaam" onclick="toonPagina('over-ons')">CHIRO SPIRIT HEVERLEE</h1>
    <small>Voorbeeldpagina</small>
  </header>

  <nav class="navbar navbar-expand-lg bg-light navbar-light">
    <div class="container-fluid justify-content-center">
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav mb-2 mb-lg-0">
          <li class="nav-item"><a class="nav-link actief active" onclick="toonPagina('over-ons')" data-id="over-ons">Over ons</a></li>
          <li class="nav-item"><a class="nav-link" onclick="toonPagina('kalender')" data-id="kalender">Kalender</a></li>
          <li class="nav-item"><a class="nav-link" onclick="toonPagina('groepen')" data-id="groepen">Groepen</a></li>
          <li class="nav-item"><a class="nav-link" onclick="toonPagina('inschrijven')" data-id="inschrijven">Inschrijven</a></li>
          <li class="nav-item"><a class="nav-link" onclick="toonPagina('verhuur')" data-id="verhuur">Verhuur</a></li>
          <li class="nav-item"><a class="nav-link" onclick="toonPagina('documenten')" data-id="documenten">Documenten</a></li>
          <li class="nav-item"><a class="nav-link" onclick="toonPagina('contact')" data-id="contact">Contact</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="row mt-3 pb-0 inhoud">
    {% include "kalender-en-groepen.njk" %}
    {% include "overige-secties.njk" %}
  </div>

</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.1/dist/js/bootstrap.bundle.min.js"></script>
<script>
function toonPagina(id) {
  document.querySelectorAll('.pagina').forEach(function(p) { p.classList.remove('actief'); });
  var doel = document.getElementById(id);
  if (doel) doel.classList.add('actief');

  document.querySelectorAll('.nav-link').forEach(function(a) {
    a.classList.toggle('actief', a.dataset.id === id);
    a.classList.toggle('active', a.dataset.id === id);
  });

  var collapse = document.getElementById('navbarSupportedContent');
  if (collapse && collapse.classList.contains('show')) {
    var bsCollapse = bootstrap.Collapse.getOrCreateInstance(collapse);
    bsCollapse.hide();
  }
  window.scrollTo({ top: 0, behavior: 'smooth' });
  history.pushState(null, '', '#' + id);
}

(function() {
  var hash = location.hash.slice(1);
  var geldig = ['over-ons','kalender','groepen','inschrijven','verhuur','documenten','contact'];
  if (hash && geldig.indexOf(hash) !== -1) {
    toonPagina(hash);
  }
})();

window.addEventListener('popstate', function() {
  var hash = location.hash.slice(1);
  if (hash) toonPagina(hash);
});
</script>

</body>
</html>