{# =====================================================================
   Plaats dit als _includes/overige-secties.njk
   Toont: Over ons, Inschrijven, Verhuur, Documenten, Contact
   ===================================================================== #}

<section id="over-ons" class="pagina">
  <h2>Over ons</h2>
  {% for pagina in collections.overOns %}
    {{ pagina.templateContent | safe }}
  {% endfor %}
  <img src="/afbeeldingen/achtergrond.jpg" alt="Chiro Spirit Heverlee op kamp" class="foto foto-midden">
</section>

<section id="inschrijven" class="pagina">
  <h2>Inschrijven</h2>
  {% for pagina in collections.inschrijvenPagina %}
    {{ pagina.templateContent | safe }}
  {% endfor %}
</section>

<section id="verhuur" class="pagina">
  <h2>Verhuur</h2>
  {% for v in collections.verhuurPagina %}
    <p>{{ v.data.intro }}</p>

    <h3>Wat wordt er verhuurd?</h3>
    <ul class="lijst lijst-bollen">
      {% for item in v.data.voorzieningen %}
        <li>{{ item }}</li>
      {% endfor %}
    </ul>
    {% if v.data.waarschuwing %}<p class="kamp-bbq"><strong>{{ v.data.waarschuwing }}</strong></p>{% endif %}

    <h3>Jokri</h3>
    <div class="foto-galerij">
      {% for foto in v.data.fotos_jokri %}
        <img src="{{ foto.foto }}" alt="Foto van Jokri" class="foto">
      {% endfor %}
    </div>

    <h3>Bouw</h3>
    <div class="foto-galerij">
      {% for foto in v.data.fotos_bouw %}
        <img src="{{ foto.foto }}" alt="Foto van de Bouw" class="foto">
      {% endfor %}
    </div>

    <h3>Terrein</h3>
    {% if v.data.terrein %}<p>{{ v.data.terrein }}</p>{% endif %}
    <div class="foto-galerij">
      {% for foto in v.data.fotos_terrein %}
        <img src="{{ foto.foto }}" alt="Foto van het terrein" class="foto">
      {% endfor %}
    </div>

    <h3>Waar?</h3>
    <p>{{ v.data.waar }}</p>

    <h3>Voor welke prijs?</h3>
    <p>{{ v.data.prijs }}</p>

    <h3>Huishoudelijk reglement</h3>
    <p><a href="{{ v.data.reglement }}" target="_blank" rel="noopener noreferrer">Huishoudelijk reglement Chiro Spirit Heverlee</a></p>

    <h3>Contact</h3>
    <p>Hebt u interesse of bijkomende vragen? U kan de verhuurverantwoordelijke bereiken via mail:
    <a href="mailto:{{ site.email_verhuur }}">{{ site.email_verhuur }}</a><br>
    of kijk op Kampas: <a href="{{ v.data.kampas_link }}" target="_blank" rel="noopener noreferrer">{{ v.data.kampas_link }}</a></p>

    <h3>Verhuurkalender</h3>
    <iframe
      src="https://calendar.google.com/calendar/embed?src=39bm26amjfhn1nou9me1iohr38%40group.calendar.google.com&ctz=Europe%2FBrussels"
      style="border: 0" width="100%" height="600" frameborder="0" scrolling="no">
    </iframe>

    <h3>Link naar Kampas</h3>
    <p><a href="{{ v.data.kampas_link }}" target="_blank" rel="noopener noreferrer">Kampas Chiro Spirit Heverlee</a></p>
  {% endfor %}
</section>

<section id="documenten" class="pagina">
  <h2>Documenten</h2>
  <ul class="lijst">
    {% for doc in collections.documentenLijst %}
      <li>
        <a href="{{ doc.data.bestand }}" target="_blank" rel="noopener noreferrer">{{ doc.data.naam }}</a>
        {% if doc.data.info %}<span class="lijst-info">{{ doc.data.info }}</span>{% endif %}
      </li>
    {% endfor %}
  </ul>
</section>

<section id="contact" class="pagina">
  <h2>Contact</h2>
  <p><strong>Algemene vragen</strong><br>
  <a href="mailto:{{ site.email_algemeen }}">{{ site.email_algemeen }}</a></p>

  <p><strong>Verhuur van de lokalen</strong><br>
  <a href="mailto:{{ site.email_verhuur }}">{{ site.email_verhuur }}</a></p>

  <p><strong>Adres</strong><br>{{ site.adres }}</p>

  <p><strong>Wanneer</strong><br>{{ site.uren }}</p>
</section>

<section id="vzw" class="pagina">
  <h2>VZW</h2>
  {% for v in collections.vzwPagina %}
    {% if v.data.intro %}<p>{{ v.data.intro }}</p>{% endif %}

    {% for s in v.data.secties %}
      <h3>{{ s.titel }}</h3>
      {{ s.tekst | markdown | safe }}
    {% endfor %}

    {% if v.data.fotos | length %}
    <div class="foto-galerij">
      {% for foto in v.data.fotos %}
        <img src="{{ foto.foto }}" alt="Foto VZW" class="foto">
      {% endfor %}
    </div>
    {% endif %}

    {% if v.data.documenten | length %}
    <h3>Documenten</h3>
    <ul class="lijst">
      {% for doc in v.data.documenten %}
        <li><a href="{{ doc.bestand }}" target="_blank" rel="noopener noreferrer">{{ doc.naam }}</a>
          {% if doc.info %}<span class="lijst-info">{{ doc.info }}</span>{% endif %}</li>
      {% endfor %}
    </ul>
    {% endif %}

    {% if v.data.contact %}
    <h3>Contact</h3>
    {{ v.data.contact | markdown | safe }}
    {% endif %}
  {% endfor %}
</section>

{% for groep in collections.groepenOpVolgorde %}
<section id="groep-{{ groep.fileSlug }}" class="pagina">
  <p><a class="groep-link" onclick="toonPagina('groepen')">← Terug naar alle groepen</a></p>
  <h2>{{ groep.data.naam }}</h2>
  {% if groep.data.leeftijd %}<p class="leeftijd">Leeftijd: {{ groep.data.leeftijd }}</p>{% endif %}
  {% if groep.data.detail_tekst %}<p>{{ groep.data.detail_tekst }}</p>{% endif %}

  {% if groep.data.foto_leiding %}
    <img class="foto groep-foto" src="{{ groep.data.foto_leiding }}" alt="Leiding {{ groep.data.naam }}">
  {% endif %}

  {% if groep.data.leiding_lijst | length %}
    <ul class="leiding-namen">
      {% for naam in groep.data.leiding_lijst %}<li>{{ naam }}</li>{% endfor %}
    </ul>
  {% endif %}

  {% if groep.data.foto_groep %}
    <img class="foto groep-foto" src="{{ groep.data.foto_groep }}" alt="Groepsfoto {{ groep.data.naam }}">
  {% endif %}
</section>
{% endfor %}


{% for p in collections.leidingPagina %}
<section id="leiding" class="pagina">
  <h2>Leiding</h2>
  {% if p.data.intro %}<p>{{ p.data.intro }}</p>{% endif %}
  {% if p.data.foto %}
    <img class="foto leiding-foto" src="{{ p.data.foto }}" alt="Alle leiding">
  {% endif %}
  {% if p.data.seizoen %}<p class="leeftijd">Leiding {{ p.data.seizoen }}</p>{% endif %}
  {% if p.data.namen | length %}
    <ul class="leiding-namen">
      {% for naam in p.data.namen %}<li>{{ naam }}</li>{% endfor %}
    </ul>
  {% endif %}
</section>
{% endfor %}